APP_NAME=Warehouse Management System
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

POSTGRES_DB=warehouse_management
POSTGRES_USER=warehouse_user
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://warehouse_user:change-me@localhost:5432/warehouse_management

JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
